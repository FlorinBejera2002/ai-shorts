{
	email admin@sneepcut.com
}

sneepcut.com, www.sneepcut.com {
	encode zstd gzip
	@application_api path /api/* /v1/* /media/*
	handle @application_api {
		reverse_proxy nginx-gateway:80 {
			header_up Host api.sneepcut.com
		}
	}
	handle {
		reverse_proxy frontend:8080
	}
}

api.sneepcut.com {
	reverse_proxy nginx-gateway:80
}

studio.sneepcut.com {
	encode zstd gzip
	reverse_proxy studio:5191
}

admin.sneepcut.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	@admin_api path /api/* /v1/*
	handle @admin_api {
		reverse_proxy nginx-gateway:80 {
			header_up Host api.sneepcut.com
		}
	}
	handle {
		reverse_proxy admin:8080
	}
}
