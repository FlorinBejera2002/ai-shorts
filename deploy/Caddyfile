{
	email admin@sneepcut.com
}

sneepcut.com, www.sneepcut.com {
	encode zstd gzip
	@studio_session path /studio-session
	header @studio_session {
		defer
		Content-Security-Policy "frame-ancestors https://studio.sneepcut.com"
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
	}
	@application_api path /api/* /v1/* /media/*
	handle @application_api {
		reverse_proxy nginx-gateway:80 {
			header_up Host api.sneepcut.com
		}
	}
	# Public pages are the static Next.js site (landing/); handles are tried in order.
	@landing_assets path /_next/* /landing/* /robots.txt /sitemap.xml *.html
	handle @landing_assets {
		reverse_proxy landing:8080
	}
	# The web app (SPA): dashboard, auth, Studio session and its build assets.
	@web_app path /dashboard* /login* /register* /forgot-password* /reset-password* /activate* /studio-session* /ro/dashboard* /ro/login* /ro/register* /ro/forgot-password* /ro/reset-password* /ro/activate* /es/dashboard* /es/login* /es/register* /es/forgot-password* /es/reset-password* /es/activate* /assets/*
	handle @web_app {
		reverse_proxy frontend:8080
	}
	# Root-level files from frontend/public (icons, illustrations, manifest).
	@web_app_files path_regexp web_app_file \.[A-Za-z0-9]+$
	handle @web_app_files {
		reverse_proxy frontend:8080
	}
	# Landing, pricing, legal pages and the 404 page for unknown paths.
	handle {
		reverse_proxy landing:8080
	}
}

api.sneepcut.com {
	import /config/agenda-style-bridge.caddy
	handle {
		reverse_proxy nginx-gateway:80
	}
}

studio.sneepcut.com {
	encode zstd gzip
	reverse_proxy studio:5191
}

admin.sneepcut.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	@admin_api path /api/* /v1/*
	handle @admin_api {
		reverse_proxy nginx-gateway:80 {
			header_up Host api.sneepcut.com
		}
	}
	handle {
		reverse_proxy admin:8080
	}
}

barber.florinbejera.com {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  Strict-Transport-Security "max-age=31536000"
  -Server
 }
 reverse_proxy 172.30.94.1:8787 {
  header_up Host barber.florinbejera.com
  header_up X-Forwarded-For {remote_host}
  header_up -CF-Connecting-IP
  header_up -X-Agenda-Platform
  header_up -X-Agenda-Migration-Key
  header_up -X-Agenda-Client-IP
 }
}
