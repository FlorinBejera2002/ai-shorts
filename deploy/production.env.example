# Copy to .env.production.local (gitignored). Generate independent secrets.
# Use hex for DB_PASSWORD so the connection URL requires no escaping.
POSTGRES_USER=sneepcut
POSTGRES_DB=sneepcut
DB_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
UPLOAD_TOKEN_SECRET=
# A persistent base64-encoded 32-byte AES key, required for social connections.
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_PUBLISHING_ENABLED=false
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_VERIFIED_URL_PREFIX=https://sneepcut.com/media/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://sneepcut.com/v1/auth/google/callback
RESEND_API_KEY=
AUTH_EMAIL_FROM=
DEFAULT_FREE_CREDITS=1000
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WORKER_CONCURRENCY=1
WORKER_CPU_LIMIT=2
WORKER_MEMORY_LIMIT=6g
YOUTUBE_COOKIES_DIR=/opt/sneepcut-secrets
YOUTUBE_COOKIES_PATH=/run/secrets/youtube-cookies.txt
# Set automatically by the release script; safe fallback for direct Compose use.
DEPLOYMENT_VERSION=production
NEXT_PUBLIC_CONTACT_EMAIL=admin@sneepcut.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_1000=
