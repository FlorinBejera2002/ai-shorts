# Backend-only production settings. Never copy secrets to NEXT_PUBLIC_*.
# Apply the Go migration chain through 20260922_x_lifecycle before enabling.
APP_URL=https://sneepcut.com
SOCIAL_PUBLISHING_ENABLED=false
# Base64-encoded 32 random bytes; retain securely for token decryption.
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_APP_ID=2537942060040854
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Credentials from Instagram API with Instagram Login, not the Meta app ID.
INSTAGRAM_APP_ID=1586978439836014
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# HTTPS media URL prefix verified in TikTok's developer console.
TIKTOK_VERIFIED_URL_PREFIX=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUDIT_APPROVED=false
YOUTUBE_MEDIA_URL_PREFIX=
YOUTUBE_IMPORT_APPROVED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# YYYYMM LinkedIn REST API version retained in the developer application.
LINKEDIN_API_VERSION=202609
# Enable only after Community Management organization permissions are approved.
LINKEDIN_ORGANIZATION_ENABLED=false
LINKEDIN_MEDIA_URL_PREFIX=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MEDIA_URL_PREFIX=
