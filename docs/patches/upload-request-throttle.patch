new file mode 100644
--- /dev/null
+++ b/backend/internal/media/upload_busy.go
@@ -0,0 +1,8 @@
+package media
+
+import "net/http"
+
+func uploadBusy(w http.ResponseWriter) {
+	w.Header().Set("Retry-After", "2")
+	writeMedia(w, http.StatusTooManyRequests, map[string]string{"error": "Uploads are temporarily busy. Retry shortly.", "detail": "Uploads are temporarily busy. Retry shortly."})
+}

diff --git a/backend/internal/media/upload_capacity_test.go b/backend/internal/media/upload_capacity_test.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/media/upload_capacity_test.go
@@ -0,0 +1,48 @@
+package media
+
+import (
+	"context"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+type countedNonce struct {
+	mockNonce
+	calls int
+}
+
+func (n *countedNonce) Allow(_ context.Context, _ string, limit int, window time.Duration) (bool, error) {
+	n.calls++
+	return n.calls <= limit && window == time.Hour, nil
+}
+func TestFiniteUploadCapacityRetainsHourlyProtection(t *testing.T) {
+	nonce := &countedNonce{}
+	s := NewService(Config{}, nil, nil, nonce, nil)
+	for i := 0; i < 400; i++ {
+		if err := s.allow(context.Background(), testUserID, "upload", UploadRequestsPerHour); err != nil {
+			t.Fatal(i, err)
+		}
+	}
+	if err := s.allow(context.Background(), testUserID, "upload", UploadRequestsPerHour); err == nil {
+		t.Fatal("hourly protection removed")
+	}
+	one, ok := s.transfers.Acquire(testUserID)
+	if !ok {
+		t.Fatal("first")
+	}
+	defer one()
+	two, ok := s.transfers.Acquire(testUserID)
+	if !ok {
+		t.Fatal("second")
+	}
+	defer two()
+	if _, ok = s.transfers.Acquire(testUserID); ok {
+		t.Fatal("active work protection removed")
+	}
+	w := httptest.NewRecorder()
+	uploadBusy(w)
+	if w.Code != 429 || w.Header().Get("Retry-After") != "2" {
+		t.Fatal("backpressure")
+	}
+}

