{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/lib/auth": ["./src/lib/auth.ts"],
      "@/hooks/use-api-resource": ["./src/hooks/use-api-resource.ts"],
      "@/components/auth/auth-guard": ["./src/components/auth/auth-guard.tsx"],
      "@/components/auth/use-auth": ["./src/components/auth/use-auth.ts"],
      "@/components/billing/plan-price": ["./src/components/billing/plan-price.tsx"],
      "@/components/billing/use-plan-catalog": ["./src/components/billing/use-plan-catalog.ts"],
      "@/i18n/navigation": ["./src/i18n/navigation.ts"],
      "@/*": ["../frontend/src/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "next/navigation": ["./src/compat/next-navigation.ts"],
      "next/image": ["./src/compat/next-image.tsx"],
      "next-intl/server": ["./src/compat/next-intl-server.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
