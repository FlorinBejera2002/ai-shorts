# === Database ===
DB_PASSWORD=changeme
# New installations use Sneepcut identifiers. Existing installations should
# keep their current values until the staged migration in docs is complete.
POSTGRES_DB=sneepcut
POSTGRES_USER=sneepcut
DATABASE_URL=postgresql://sneepcut:changeme@postgres:5432/sneepcut
DIRECT_URL=postgresql://sneepcut:changeme@postgres:5432/sneepcut

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === NextAuth ===
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=[http://localhost:3000](http://localhost:3000)
# Password reset delivery: set an HTTPS NEXTAUTH_URL, a Resend key, and a
# verified sender. With APP_ENV=development/test, unset keys use local logs.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Required for the known Cloudflare/reverse-proxy host in production.
AUTH_TRUST_HOST=true
INTERNAL_API_KEY=generate-with-openssl-rand-base64-32
UPLOAD_TOKEN_SECRET=generate-with-openssl-rand-base64-32
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Go authentication ===
GO_AUTH_ENABLED=true
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_ISSUER=sneepcut
JWT_AUDIENCE=sneepcut-web
# Optional public address shown on privacy and legal pages. Leave empty until
# the operator has verified the mailbox; no placeholder address is displayed.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set this to https://<public-backend>/api/upload/direct in Cloudflare
# production so large files bypass the Worker's request-body limit.
NEXT_PUBLIC_UPLOAD_URL=
MEDIA_PROXY_HOST=http://nginx:80

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/v1/auth/google/callback

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_CREDITS_100=price_...
STRIPE_PRICE_CREDITS_500=price_...
STRIPE_PRICE_CREDITS_1000=price_...

# === AI APIs ===
# `auto` keeps an existing Gemini deployment on Gemini, or selects OpenRouter
# when OPENROUTER_API_KEY is the only configured cloud AI key.
# openrouter | gemini | auto
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENROUTER_API_KEY=
# Any text/chat model slug returned by https://openrouter.ai/api/v1/models.
OPENROUTER_MODEL_NAME=google/gemini-2.5-flash
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
# Total job limits in seconds, including download, transcription and rendering.
WORKER_SOFT_TIME_LIMIT=7200
WORKER_TIME_LIMIT=7500

# === Social Posting ===
UPLOAD_POST_API_KEY=

# === Storage ===
STORAGE_TYPE=local
LOCAL_MEDIA_ROOT=/app/media
# For S3/R2:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_S3_BUCKET=sneepcut-media
# AWS_S3_PUBLIC_BUCKET=sneepcut-public
# AWS_ENDPOINT_URL=[https://xxx.r2.cloudflarestorage.com](https://xxx.r2.cloudflarestorage.com)
# AWS_PUBLIC_BASE_URL=[https://cdn.example.com](https://cdn.example.com)

# === App ===
APP_NAME=Sneepcut
APP_URL=http://localhost:3000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1,backend
NEXT_IMAGE_REMOTE_HOSTS=
MAX_UPLOAD_SIZE_MB=2048
# Production always requires a clean ClamAV verdict. Enable locally to test it.
UPLOAD_SCANNER_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
MAX_VIDEO_DURATION_MINUTES=120
DEFAULT_FREE_CREDITS=1000
MAX_CLIPS=15
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=60
YOUTUBE_COOKIES_PATH=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SMART_CROP_ENABLED=true
SUBTITLES_ENABLED=true
