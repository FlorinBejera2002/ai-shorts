# === Database ===
DB_PASSWORD=changeme
# New installations use Sneepcut identifiers. Existing installations should
# keep their current values until the staged migration in docs is complete.
POSTGRES_DB=sneepcut
POSTGRES_USER=sneepcut
DATABASE_URL=postgresql://sneepcut:changeme@postgres:5432/sneepcut
DIRECT_URL=postgresql://sneepcut:changeme@postgres:5432/sneepcut

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === NextAuth ===
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=[http://localhost:3000](http://localhost:3000)
# Password reset delivery: set an HTTPS NEXTAUTH_URL, a Resend key, and a
# verified sender. With APP_ENV=development/test, unset keys use local logs.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Required for the known Cloudflare/reverse-proxy host in production.
AUTH_TRUST_HOST=true
INTERNAL_API_KEY=generate-with-openssl-rand-base64-32
UPLOAD_TOKEN_SECRET=generate-with-openssl-rand-base64-32
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Go authentication ===
GO_AUTH_ENABLED=true
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_ISSUER=sneepcut
JWT_AUDIENCE=sneepcut-web
# Optional public address shown on privacy and legal pages. Leave empty until
# the operator has verified the mailbox; no placeholder address is displayed.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set this to https://<public-backend>/api/upload/direct in Cloudflare
# production so large files bypass the Worker's request-body limit.
NEXT_PUBLIC_UPLOAD_URL=
MEDIA_PROXY_HOST=http://nginx:80

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/v1/auth/google/callback

# === Stripe ===
# Hosted Checkout needs no browser publishable key. Keep all secrets server-side.
# See docs/stripe-billing.md. Live payments require explicit STRIPE_MODE=live.
STRIPE_MODE=test
# Set to the verified sandbox account ID for configuration and real-provider tests.
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pin the reviewed Customer Portal configuration from the same Stripe sandbox.
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Optional legacy credit-pack fulfillment; do not configure until approved.
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_1000=

# === AI APIs ===
# `auto` keeps an existing Gemini deployment on Gemini, or selects OpenRouter
# when OPENROUTER_API_KEY is the only configured cloud AI key.
# openrouter | gemini | auto
AI_PROVIDER=auto
GEMINI_API_KEY=
# API/worker models are selected per task in Admin > Modele AI.
# These legacy global names apply only to standalone Studio mode.
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=google/gemini-2.5-flash
# The worker and API use Studio for all composition rendering and editing.
STUDIO_AGENT_URL=http://studio:5191
# Shared API/worker/Studio credential. `make ensure-env` generates a missing
# local secret once; existing values are retained. Production uses its own secret.
STUDIO_AGENT_SECRET=
# Optional exact origin for signed S3 asset URLs; empty for local media storage.
SNEEPCUT_MEDIA_S3_ORIGIN=
SNEEPCUT_MEDIA_S3_INTERNAL_ORIGIN=
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
# Total job limits in seconds, including download, transcription and rendering.
WORKER_SOFT_TIME_LIMIT=7200
WORKER_TIME_LIMIT=7500

# === Social Posting ===
UPLOAD_POST_API_KEY=

# === Storage ===
# Host-visible local runtime data. Keep outside the checkout and .cache.
SNEEPCUT_RUNTIME_ROOT=../ai-shorts-runtime
STORAGE_TYPE=local
LOCAL_MEDIA_ROOT=/app/media
# Development-only SeaweedFS, started by make dev-up or make seaweed-up.
# These credentials are local defaults, never production credentials.
SEAWEEDFS_PORT=8333
SEAWEEDFS_ACCESS_KEY_ID=sneepcut-dev
SEAWEEDFS_SECRET_ACCESS_KEY=sneepcut-local-development-only
SEAWEEDFS_BUCKET=sneepcut-dev
# For S3-compatible media storage (see README's Local S3 development section):
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=fsn1
# AWS_S3_BUCKET=sneepcut-media
# AWS_ENDPOINT_URL=https://fsn1.your-objectstorage.com
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_PUBLIC_BASE_URL=
# Studio uses the same private bucket under studio/v1, with disposable filesystem copies.
SNEEPCUT_STUDIO_STORAGE=local
# Internal server endpoint for local Docker; leave unset for the production provider endpoint.
# SNEEPCUT_STUDIO_S3_ENDPOINT=http://seaweedfs:8333
SNEEPCUT_STUDIO_S3_PREFIX=studio/v1

# === App ===
APP_NAME=Sneepcut
APP_URL=http://localhost:3000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1,backend
NEXT_IMAGE_REMOTE_HOSTS=
MAX_UPLOAD_SIZE_MB=2048
# Production always requires a clean ClamAV verdict. Enable locally to test it.
UPLOAD_SCANNER_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
MAX_VIDEO_DURATION_MINUTES=120
DEFAULT_FREE_CREDITS=1000
MAX_CLIPS=15
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=60
YOUTUBE_COOKIES_PATH=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Enable only after the YouTube API compliance audit is approved.
YOUTUBE_AUDIT_APPROVED=false
# HTTPS prefix used by signed video URLs; defaults to AWS_PUBLIC_BASE_URL or APP_URL/media/.
YOUTUBE_MEDIA_URL_PREFIX=
# Enable audiovisual imports only with prior written approval from YouTube.
YOUTUBE_IMPORT_APPROVED=false
SMART_CROP_ENABLED=true
SUBTITLES_ENABLED=true
# Story speech extraction requires Silero VAD. Worker images bundle this model.
# Native installs default to ggml-silero-v6.2.0.bin beside the story Whisper model.
# WHISPER_CPP_VAD_MODEL=/models/ggml-vad.bin
# Native installs use whisper-vad-speech-segments beside whisper-cli by default.
# WHISPER_CPP_VAD_PATH=/usr/local/bin/whisper-vad-speech-segments
