generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique @db.VarChar(255)
  name                     String?   @db.VarChar(255)
  image                    String?   @map("avatar_url") @db.VarChar(1024)
  provider                 String    @default("credentials") @db.VarChar(50)
  providerId               String?   @map("provider_id") @db.VarChar(255)
  passwordHash             String?   @map("password_hash") @db.VarChar(255)
  sessionVersion           Int       @default(0) @map("session_version")
  credits                  Int       @default(100)
  plan                     String    @default("free") @db.VarChar(50)
  stripeCustomerId         String?   @unique(map: "uq_users_stripe_customer_id") @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId     String?   @unique(map: "uq_users_stripe_subscription_id") @map("stripe_subscription_id") @db.VarChar(255)
  stripeSubscriptionStatus String?   @map("stripe_subscription_status") @db.VarChar(50)
  stripeCurrentPeriodEnd   DateTime? @map("stripe_current_period_end") @db.Timestamptz(6)
  stripeCancelAtPeriodEnd  Boolean   @default(false) @map("stripe_cancel_at_period_end")
  stripeStateEventCreated  BigInt    @default(0) @map("stripe_state_event_created")
  stripeStateEventPriority Int       @default(0) @map("stripe_state_event_priority")
  stripeCheckoutGeneration Int       @default(0) @map("stripe_checkout_generation")
  stripeStateGeneration    Int       @default(0) @map("stripe_state_generation")
  emailVerified            DateTime? @map("email_verified")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts             Account[]
  sessions             Session[]
  jobs                 Job[]
  clips                Clip[]
  brandKit             BrandKit?
  scheduledPosts       ScheduledPost[]
  chatMessages         ChatMessage[]
  billingCheckoutClaim BillingCheckoutClaim?

  @@map("users")
}

model BillingCheckoutClaim {
  userId            String   @id @map("user_id") @db.Uuid
  token             String   @db.VarChar(64)
  planId            String   @map("plan_id") @db.VarChar(32)
  priceId           String   @map("price_id") @db.VarChar(255)
  locale            String   @db.VarChar(8)
  customerId        String?  @map("customer_id") @db.VarChar(255)
  customerEmail     String   @map("customer_email") @db.VarChar(255)
  successUrl        String   @map("success_url") @db.VarChar(2048)
  cancelUrl         String   @map("cancel_url") @db.VarChar(2048)
  generation        Int
  sessionId         String?  @unique(map: "uq_billing_checkout_claims_session_id") @map("session_id") @db.VarChar(255)
  leaseExpiresAt    DateTime @map("lease_expires_at") @db.Timestamptz(6)
  checkoutExpiresAt DateTime @map("checkout_expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_checkout_claims")
}

model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Job {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  sourceType         String    @map("source_type") @db.VarChar(50)
  sourceUrl          String?   @map("source_url") @db.VarChar(2048)
  sourceFilePath     String?   @map("source_file_path") @db.VarChar(2048)
  sourceVideoUrl     String?   @map("source_video_url") @db.VarChar(2048)
  sourceStorageKey   String?   @map("source_storage_key") @db.VarChar(2048)
  status             String    @default("pending") @db.VarChar(50)
  processingActive   Boolean   @default(false) @map("processing_active")
  progress           Int       @default(0)
  progressMessage    String?   @map("progress_message") @db.VarChar(512)
  numClipsRequested  Int       @default(5) @map("num_clips_requested")
  aspectRatio        String    @default("9:16") @map("aspect_ratio") @db.VarChar(20)
  language           String?   @db.VarChar(50)
  subtitleStyle      String    @default("default") @map("subtitle_style") @db.VarChar(50)
  includeBrand       Boolean   @default(false) @map("include_brand")
  userInstructions   String?   @map("user_instructions")
  transcriptSegments Json?     @map("transcript_segments")
  creditsCharged     Int       @default(0) @map("credits_charged")
  errorMessage       String?   @map("error_message")
  celeryTaskId       String?   @map("celery_task_id") @db.VarChar(255)
  activeEditTasks    Int       @default(0) @map("active_edit_tasks")
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips Clip[]

  @@index([userId])
  @@index([status])
  @@map("jobs")
}

model Clip {
  id                  String   @id @default(uuid()) @db.Uuid
  jobId               String   @map("job_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  title               String   @db.VarChar(255)
  hookText            String?  @map("hook_text") @db.VarChar(255)
  viralScore          Int      @default(0) @map("viral_score")
  scoreReason         String?  @map("score_reason")
  startTime           Float    @map("start_time")
  endTime             Float    @map("end_time")
  duration            Float
  segments            Json?    @map("segments")
  filePath            String   @map("file_path") @db.VarChar(2048)
  fileUrl             String?  @map("file_url") @db.VarChar(2048)
  fileStorageKey      String?  @map("file_storage_key") @db.VarChar(2048)
  thumbnailPath       String?  @map("thumbnail_path") @db.VarChar(2048)
  thumbnailUrl        String?  @map("thumbnail_url") @db.VarChar(2048)
  thumbnailStorageKey String?  @map("thumbnail_storage_key") @db.VarChar(2048)
  fileSize            Int      @default(0) @map("file_size")
  resolution          String   @db.VarChar(50)
  aspectRatio         String   @default("9:16") @map("aspect_ratio") @db.VarChar(20)
  hasSubtitles        Boolean  @default(false) @map("has_subtitles")
  transcriptText      String?  @map("transcript_text")
  captionTiktok       String?  @map("caption_tiktok")
  captionInstagram    String?  @map("caption_instagram")
  captionYoutube      String?  @map("caption_youtube")
  suggestedHashtags   String?  @map("suggested_hashtags")
  publishedTo         Json?    @map("published_to")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]
  chatMessages   ChatMessage[]

  @@unique([id, userId], map: "uq_clips_id_user_id")
  @@index([jobId])
  @@index([userId])
  @@map("clips")
}

model ScheduledPost {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  clipId      String?  @map("clip_id") @db.Uuid
  clipOwnerId String?  @map("clip_owner_id") @db.Uuid
  title       String   @db.VarChar(120)
  caption     String?
  notes       String?
  platforms   String[] @db.VarChar(32)
  status      String   @default("draft") @db.VarChar(32)
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip Clip? @relation(fields: [clipId, clipOwnerId], references: [id, userId], onDelete: SetNull, map: "fk_scheduled_posts_owned_clip")

  @@index([userId, scheduledAt], map: "ix_scheduled_posts_user_scheduled_at")
  @@index([userId, status], map: "ix_scheduled_posts_user_status")
  @@index([clipId], map: "ix_scheduled_posts_clip_id")
  @@map("scheduled_posts")
}

model BrandKit {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  logoPath          String?  @map("logo_path") @db.VarChar(2048)
  logoUrl           String?  @map("logo_url") @db.VarChar(2048)
  primaryColor      String   @default("#6366f1") @map("primary_color") @db.VarChar(20)
  secondaryColor    String   @default("#8b5cf6") @map("secondary_color") @db.VarChar(20)
  fontFamily        String   @default("Inter") @map("font_family") @db.VarChar(100)
  subtitleFont      String   @default("Inter Bold") @map("subtitle_font") @db.VarChar(100)
  subtitleColor     String   @default("#FFFFFF") @map("subtitle_color") @db.VarChar(20)
  subtitleBgColor   String   @default("#000000") @map("subtitle_bg_color") @db.VarChar(20)
  subtitleBgOpacity Float    @default(0.7) @map("subtitle_bg_opacity")
  subtitlePosition  String   @default("bottom") @map("subtitle_position") @db.VarChar(20)
  introVideoPath    String?  @map("intro_video_path") @db.VarChar(2048)
  outroVideoPath    String?  @map("outro_video_path") @db.VarChar(2048)
  watermarkPath     String?  @map("watermark_path") @db.VarChar(2048)
  watermarkPosition String   @default("bottom-right") @map("watermark_position") @db.VarChar(20)
  watermarkOpacity  Float    @default(0.8) @map("watermark_opacity")
  hidePlatformBadge Boolean  @default(false) @map("hide_platform_badge")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model StripeEvent {
  id            String   @id @db.VarChar(255)
  type          String   @db.VarChar(100)
  creditGrantId String?  @unique(map: "uq_stripe_events_credit_grant_id") @map("credit_grant_id") @db.VarChar(255)
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("stripe_events")
}

/// Durable account-deletion work item. This deliberately has no relation or
/// foreign key to User: the record must survive until the final transaction
/// removes both it and the account atomically.
model AccountDeletionRequest {
  userId                       String   @id @map("user_id") @db.Uuid
  stripeCustomerId             String?  @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId         String?  @map("stripe_subscription_id") @db.VarChar(255)
  billingCancellationCompleted Boolean  @default(false) @map("billing_cancellation_completed")
  lastFailure                  String?  @map("last_failure") @db.VarChar(64)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("account_deletion_requests")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clipId    String?  @map("clip_id") @db.Uuid
  context   String   @db.VarChar(20)
  role      String   @db.VarChar(20)
  content   String
  actions   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip Clip? @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_chat_messages_user_id")
  @@index([userId, context, createdAt], map: "ix_chat_messages_user_context_created")
  @@index([clipId, createdAt], map: "ix_chat_messages_clip_created")
  @@map("chat_messages")
}
