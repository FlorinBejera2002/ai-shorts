# go:embed preserves bytes, unlike Python's universal-newline source reader.
# Keep prompts identical to the Python contracts in checkouts and Git archives.
backend-go/internal/**/prompts/*.txt text eol=lf

# Linux interpreters and runtime configuration parsers require Unix newlines.
scripts/*.sh text eol=lf
backend/clamav/*.conf text eol=lf
nginx/*.conf text eol=lf
deploy/*.conf text eol=lf
deploy/Caddyfile text eol=lf
